<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - lelek.dev</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lelek.dev.styles.css" asp-append-version="true" />
</head>
<body>

<header>
    <nav>
        <ul class="nav-list-top">
            <li><a href="/home">/home</a></li>
            <li><a href="/html/posts.html">/posts</a></li>
            <li id="theme-toggle-li">
                <div id="theme-toggle" type="button" aria-label="Change theme">
                    <i data-lucide="palette"></i>
                </div>
            </li>
        </ul>
    </nav>
    <hr>
</header>

<main>
    @RenderBody()
</main>

<footer>
    <hr style="margin-top: 50px;">
    <nav>
        <ul class="nav-list">
            <li><a href="https://github.com/theLelek">github</a></li>
        </ul>
    </nav>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

<script src="https://unpkg.com/lucide@latest"></script>
<script>
    lucide.createIcons();
</script>
<script src="~/js/site.js" asp-append-version="true"></script>

</body>
</html>